# ตัวอย่างไฟล์ .env สำหรับ **บน VPS** (วางไว้ข้าง docker-compose.yml ชื่อ `.env`)
# ห้าม commit ไฟล์จริง — .gitignore กัน `.env*` ไว้แล้ว
#
# ค่าเดียวกันนี้อีกชุดต้องไปอยู่ใน GitHub Secrets ด้วย (เฉพาะที่ workflow ใช้ตอน build/deploy)

# ---- โดเมนของเว็บ ----
# ⚠️ ต้องเป็น https จริง ไม่งั้น Better Auth ตอบ 403 INVALID_ORIGIN และ sitemap/OG ชี้ผิด
SITE_URL="https://example.ac.th"
SITE_DOMAIN="example.ac.th"   # ใช้เฉพาะตอนให้ Caddy ขอใบรับรอง

# ---- ฐานข้อมูล (container `db` ใน compose) ----
POSTGRES_USER="tguser"
POSTGRES_PASSWORD="<สุ่มยาว ๆ>"
POSTGRES_DB="thaingamweb"

# ---- Better Auth ----
BETTER_AUTH_SECRET="<สุ่ม 32 ตัวอักษรขึ้นไป>"

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""   # ⚠️ ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ เด็ดขาด

# ---- Email (ยังไม่ได้ใช้ — reset password ยังไม่ได้ทำ) ----
RESEND_API_KEY=""
EMAIL_FROM=""

# ---- image ที่จะรัน (GitHub Actions เขียนทับให้ตอน deploy) ----
APP_IMAGE="ghcr.io/greengramhouse/thaingam-web-latest:latest"
APP_HOST_PORT="3001"   # ⚠️ ไม่ใช่ 3000 — VPS เครื่องนี้มี StockApp ใช้ 127.0.0.1:3000 อยู่แล้ว
DB_HOST_PORT="5433"    # พอร์ต Postgres ฝั่ง localhost ของ VPS (ใช้ตอน seed/สำรองข้อมูลผ่าน SSH tunnel)

# ℹ️ ไม่มี SEED_* ที่นี่ — seed ครั้งแรกรันจากเครื่องผู้ดูแลผ่าน SSH tunnel (ดู docs/deploy.md)
