// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ======================= Enums =======================
enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

// ชนิดของผลงาน/สื่อการสอน — กำหนดว่าใช้ field ไหน (youtubeUrl / videoUrl / content)
enum MediaType {
  YOUTUBE
  VIDEO
  ARTICLE
}

// ==================== Better Auth ====================
// relation ไป content ที่เหลือ (events/pages) จะเติมกลับตอนเพิ่มแต่ละ model
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(TEACHER)
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  news          News[]
  mediaWorks    MediaWork[]
  events        Event[]
  albums        Album[]
  pages         Page[]
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String? // admin plugin (impersonation)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
  @@map("verification")
}

// ====================== Content ======================
// วางเฉพาะที่ News (Phase 4.4.1) โยงถึง — MediaWork/Event/Staff/... เพิ่มตอนทำ module นั้น
model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  news        News[]

  @@map("category")
}

model Tag {
  id         String      @id @default(cuid())
  name       String
  slug       String      @unique
  news       News[]
  mediaWorks MediaWork[]

  @@map("tag")
}

model News {
  id         String        @id @default(cuid())
  title      String
  // slug ตั้งเองตอนเขียนข่าว (อังกฤษ+เลข) — ไม่ auto-gen จากชื่อไทย
  slug       String        @unique
  excerpt    String?
  content    String // rich text (HTML จาก Tiptap)
  coverImage String? // Cloudinary secure_url
  status     PublishStatus @default(DRAFT)
  featured   Boolean       @default(false)
  // เซ็ตตอนกด publish ครั้งแรก แล้วคงค่าไว้ (unpublish/republish ไม่รีเซ็ต)
  publishedAt DateTime?
  viewCount   Int      @default(0)
  categoryId  String?
  // ลบหมวดหมู่แล้วข่าวต้องไม่หาย → คืน null
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags        Tag[]
  authorId    String?
  // ลบ user แล้วข่าวต้องไม่หายตามไปด้วย → คืน null (spec เดิมบังคับ authorId; ตั้งใจคลายให้ nullable)
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
  @@map("news")
}

/// ผลงาน / สื่อการสอน — 1 รายการเป็นได้ชนิดเดียว (type) แล้วใช้ field ตามชนิดนั้น
/// YOUTUBE → youtubeUrl · VIDEO → videoUrl · ARTICLE → content
/// อีก 2 field ที่ไม่ใช่ชนิดนั้นถูกล้างเป็น null ตอนบันทึก (กันข้อมูลค้างตอนสลับชนิด)
model MediaWork {
  id          String        @id @default(cuid())
  title       String
  // slug ตั้งเอง ไม่ auto-gen จากชื่อไทย (เหมือน News — ดู lib/validations/slug.ts)
  slug        String        @unique
  description String?
  type        MediaType
  youtubeUrl  String? // type = YOUTUBE
  videoUrl    String? // type = VIDEO
  content     String? // type = ARTICLE (rich text จาก Tiptap)
  thumbnail   String? // Cloudinary secure_url
  status      PublishStatus @default(DRAFT)
  featured    Boolean       @default(false)
  // เซ็ตตอนกด publish ครั้งแรก แล้วคงค่าไว้ (เหมือน News)
  publishedAt DateTime?
  tags        Tag[]
  authorId    String?
  // ลบ user แล้วผลงานต้องไม่หายตามไปด้วย → คืน null (spec เดิมบังคับ authorId; คลายให้ตรงกับ News)
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type, status])
  @@index([status, publishedAt])
  @@index([authorId])
  @@map("media_work")
}

/// กิจกรรม / ปฏิทินโรงเรียน — 1 รายการมีช่วงเวลา (startDate → endDate) กับ flag allDay
/// endDate ว่าง = กิจกรรมวันเดียว · allDay = ทั้งวัน (input เป็น date ไม่มีเวลา)
/// color = hex สำหรับระบายสีใน FullCalendar (Phase 4.6) — ว่างได้
model Event {
  id          String        @id @default(cuid())
  title       String
  description String?
  location    String?
  startDate   DateTime
  endDate     DateTime? // ว่าง = วันเดียว · มีค่า = ข้ามวัน (multi-day)
  allDay      Boolean       @default(false)
  color       String? // hex เช่น "#3b82f6" สำหรับปฏิทิน
  coverImage  String? // Cloudinary secure_url
  status      PublishStatus @default(PUBLISHED)
  authorId    String?
  // ลบ user แล้วกิจกรรมต้องไม่หายตามไปด้วย → คืน null (คลายจาก spec ให้ตรงกับ News/MediaWork)
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([startDate])
  @@index([status, startDate])
  @@map("event")
}

/// ทำเนียบบุคลากร — เรียงตาม order (น้อย→มาก) แล้วชื่อ · isActive=false = ซ่อนจากหน้าเว็บแต่ยังเก็บไว้
/// ไม่มี publish/slug/tags/author — เป็นข้อมูลคงที่ ไม่ใช่คอนเทนต์ที่มีวันเผยแพร่
model Staff {
  id         String   @id @default(cuid())
  name       String
  position   String // ตำแหน่ง เช่น ผู้อำนวยการ, ครูชำนาญการ
  department String? // กลุ่มสาระ/ฝ่าย
  photo      String? // Cloudinary secure_url
  email      String?
  phone      String?
  bio        String? // ประวัติ/รายละเอียดสั้น ๆ (ข้อความธรรมดา)
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([order])
  @@map("staff")
}

/// อัลบั้มภาพกิจกรรม — มีหลายรูป (Photo) · likeCount denormalized (ปุ่มไลก์สาธารณะ Phase 4.6)
/// eventDate = วันที่จัดกิจกรรม (ระดับวัน ไม่มีเวลา) · slug ตั้งเอง (อังกฤษ+เลข เหมือน News)
model Album {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?
  coverImage  String? // Cloudinary secure_url — ถ้าว่างหน้า public หยิบรูปแรกในอัลบั้มมาแสดง
  eventDate   DateTime? // วันที่จัดกิจกรรม (เก็บเที่ยงคืนท้องถิ่นเหมือน event allDay)
  status      PublishStatus @default(PUBLISHED)
  likeCount   Int           @default(0) // denormalized — อัปเดตตอนกดไลก์ (Phase 4.6) · แอดมินดูอย่างเดียว
  photos      Photo[]
  likes       AlbumLike[]
  authorId    String?
  // ลบ user แล้วอัลบั้มต้องไม่หาย → คืน null (ตรงกับ News/MediaWork/Event)
  author      User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, eventDate])
  @@index([authorId])
  @@map("album")
}

/// รูปในอัลบั้ม — ลบอัลบั้มแล้วรูปหายตาม (Cascade) · order = ลำดับแสดง (สลับด้วยปุ่มขึ้น/ลง)
model Photo {
  id      String  @id @default(cuid())
  albumId String
  album   Album   @relation(fields: [albumId], references: [id], onDelete: Cascade)
  url     String // Cloudinary secure_url (หรือ URL รูปที่วางเอง)
  caption String?
  order   Int     @default(0)

  @@index([albumId, order])
  @@map("photo")
}

/// ไลก์อัลบั้มแบบไม่ต้องล็อกอิน — 1 visitor (cookie id) ไลก์ได้ครั้งเดียวต่ออัลบั้ม
/// likeCount ใน Album เก็บ denormalized ไว้ (อัปเดตพร้อมกันใน transaction ตอน toggle)
model AlbumLike {
  id          String   @id @default(cuid())
  albumId     String
  album       Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  fingerprint String // visitor cookie id — กันไลก์ซ้ำจากเบราว์เซอร์เดิม
  createdAt   DateTime @default(now())

  @@unique([albumId, fingerprint])
  @@index([albumId])
  @@map("album_like")
}

/// ศูนย์ดาวน์โหลดเอกสาร — ไฟล์ (PDF ฯลฯ) เก็บเป็น URL (Cloudinary/Drive) เท่านั้น ไม่มีไฟล์บน server (spec §5)
/// category = หมวดแบบข้อความอิสระ (ประกาศ/แบบฟอร์ม/หลักสูตร…) · fileType ว่างได้ (เดาจาก fileUrl ตอนแสดงผล)
/// downloadCount denormalized — แอดมินดูอย่างเดียว (นับตอนกดดาวน์โหลดหน้า public Phase 4.6)
model Document {
  id            String        @id @default(cuid())
  title         String
  description   String?
  fileUrl       String
  fileType      String?
  category      String?
  status        PublishStatus @default(PUBLISHED)
  downloadCount Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([category])
  @@map("document")
}

/// แบนเนอร์ Hero หน้าแรก — เรียงตาม order (น้อย→มาก) · isActive=false = ซ่อนจากสไลด์แต่ยังเก็บไว้
/// image เก็บ URL (Cloudinary/Drive) · title/linkUrl ไม่บังคับ (บางแบนเนอร์เป็นภาพล้วนไม่มีลิงก์)
model Banner {
  id        String   @id @default(cuid())
  title     String?
  image     String
  linkUrl   String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order, isActive])
  @@map("banner")
}

/// แถบประกาศด่วนบนสุดของหน้าแรก — ข้อความสั้น ๆ + ลิงก์ (ไม่บังคับ)
/// isActive=false = ปิดถาวร · startsAt/endsAt = ช่วงเวลาแสดงอัตโนมัติ (ว่าง = ไม่จำกัดฝั่งนั้น)
/// หน้า public (Phase 4.5) แสดงเมื่อ isActive && อยู่ในช่วงเวลา
model Announcement {
  id        String    @id @default(cuid())
  message   String
  linkUrl   String?
  isActive  Boolean   @default(true)
  startsAt  DateTime? // ว่าง = แสดงทันที
  endsAt    DateTime? // ว่าง = ไม่มีกำหนดหมดอายุ
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive, startsAt, endsAt])
  @@map("announcement")
}

/// หน้าเนื้อหาคงที่ที่แก้ผ่านแอดมิน (ระเบียบ/หลักสูตร/การรับสมัคร/เกี่ยวกับเรา…)
/// slug ตั้งเอง (อังกฤษ+เลข) → หน้า public render ที่ /[slug] (Phase 4.6) · admission อ่าน slug 'admission'
/// ไม่มี tags/cover/featured — เป็นเนื้อหาหน้าเดียว rich text (เหมือน News แต่ตัดทิ้งเยอะ)
model Page {
  id        String        @id @default(cuid())
  slug      String        @unique
  title     String
  content   String // rich text (HTML จาก Tiptap)
  status    PublishStatus @default(PUBLISHED)
  authorId  String?
  // ลบ user แล้วหน้าต้องไม่หาย → คืน null (ตรงกับ News/MediaWork/Event/Album)
  author    User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@map("page")
}

/// ตั้งค่าเว็บไซต์แบบ key-value — ชุดคีย์คงที่นิยามที่ lib/site-settings.ts (contact.* / social.* / map.* / site.*)
/// Footer + หน้า contact (Phase 4.5/4.6) อ่านค่าเหล่านี้ · แก้ได้เฉพาะ SUPER_ADMIN
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_setting")
}

/// กล่องข้อความติดต่อ — ข้อความจากฟอร์ม "ติดต่อเรา" หน้า public (Phase 4.6, unauthenticated)
/// แอดมินอ่าน/ทำเครื่องหมายอ่านแล้ว/ลบ · ไม่มีการแก้ไขเนื้อหา (เป็นข้อความที่ผู้ส่งกรอกมา)
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
  @@map("contact_message")
}
