# ===== Thaingam-web — ตัวอย่างค่า env (คัดลอกเป็น .env แล้วกรอกค่าจริง) =====

# Database (PostgreSQL — local / Neon / Supabase)
# รูปแบบ: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/thaingamweb?schema=public"

# Better Auth
# ⚠️ ต้องตรงกับ origin ที่ dev server รันจริง ไม่งั้น endpoint ที่เช็ค CSRF จะตอบ 403 INVALID_ORIGIN
#    โปรเจกต์นี้ใช้ port 4000 (Windows/WinNAT จอง 3000 ไว้ → EACCES) — ฝังไว้ใน `package.json` แล้ว (`next dev -p 4000`)
BETTER_AUTH_SECRET="<random-32-chars+>"
BETTER_AUTH_URL="http://localhost:4000"

# Seed SUPER_ADMIN (prisma db seed)
SEED_ADMIN_EMAIL="admin@thaingam-school.ac.th"
SEED_ADMIN_PASSWORD="<strong-password>"
SEED_ADMIN_NAME="ผู้ดูแลระบบ"

# Email (Resend — reset password)
RESEND_API_KEY=""
EMAIL_FROM="no-reply@thaingam-school.ac.th"

# Cloudinary — อัปโหลดแบบ signed (ไม่ใช้ unsigned preset เพราะเปิดให้ใครก็อัปเข้าบัญชีได้)
# ⚠️ API_SECRET ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ เด็ดขาด (จะหลุดไปฝั่ง client) — ใช้เซ็นที่ /api/sign-cloudinary-params เท่านั้น
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# 2 ตัวนี้ CldUploadWidget อ่านฝั่ง client — cloud name + api key เปิดเผยได้ตามการออกแบบของ Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_API_KEY=""
